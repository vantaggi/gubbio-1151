# La gola del Bottaccione e il Condotto. Mi frigio, vento, gocce e un cuore lontano.
titolo: Gubbio 1151 - Il Bottaccione
bpm: 80
battuta: 16
canale bordone bordone 128
canale vento vento 128
canale arpa arpa 100
canale voci coro 160
canale gocce goccia 200
canale cuore tamburo 128
canale canto ciaramella 80

def ost: E3:3 F3:3 E3:2 B2:8
def ost2: E3:3 F3:3 G3:2 F3:8
def gocce: r:5 B5:1!30 r:10 | r:12 E6:1!24 r:3 | r:2 F6:1!28 r:13 | r:9 C6:1!20 r:6 |
def gocce2: r:9 F6:1!26 r:6 | r:3 B5:1!22 r:12 | r:14 E6:1!28 r:1 | r:6 G6:1!18 r:9 |
def cuore: (x:2!28 x:14!18)*4

ordine: I *A B A C

[I] 16
bordone: E2:16!30
vento: C4:16!26
cuore: x:2!28 x:14!18

[A] 64
bordone: ~:64
vento: ~:64
arpa: !34 $ost $ost $ost $ost2
gocce: $gocce
cuore: $cuore

[B] 64
bordone: ~:64
vento: ~:64
arpa: !32 $ost $ost $ost2 $ost2
voci: E4:32!20 F4:32!22
gocce: $gocce2
cuore: $cuore
canto: r:32 B3:16!20 C4:16!18

[C] 64
bordone: ~:64
vento: ~:64
arpa: !34 $ost E3:3 G3:3 F3:2 E3:8 $ost D3:3 E3:3 F3:2 E3:8
voci: G4:32!20 F4:32!20
gocce: $gocce
cuore: $cuore
canto: E4:16!18 F4:16 E4:32
