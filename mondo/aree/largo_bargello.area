# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id largo_bargello
etichetta AREA_LARGO_BARGELLO
dimensioni 32 32
riferimento 16 16
fattore 0.73
# Decoro: la Fontana dei Matti (F, 3x3) dove la mette il censimento, rispetto al Bargello.
spawn 0 19 16
spawn 1 15 22
spawn 2 15 8
uscita B via_dei_consoli 1
uscita A san_martino 2
griglia
