# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id piazza_grande
etichetta AREA_PIAZZA_GRANDE
dimensioni 64 64
# Dislivello: la salita va verso nord-est (in basso a destra); i gradoni corrono lungo il lato
# lungo dell'area, a valle c'e' l'ombra.
monte basso
# Belvedere: parapetto sul bordo a valle, l'area e' alta sulla citta'.
belvedere alto
riferimento 37 32
# Fattore ridotto: con 0,73 gli edifici e le distanze non entrano in 64x64 tile.
fattore 0.53
# consoli: spostato di (-19, 0) tile perche' nei rettangoli del censimento si sovrapporrebbe
# a un altro edificio (o resterebbero meno di 2 tile per passare).
sposta consoli -19 0
# pretorio: spostato di (-5, 0) tile perche' nei rettangoli del censimento si sovrapporrebbe
# a un altro edificio (o resterebbero meno di 2 tile per passare).
sposta pretorio -5 0
spawn 0 32 31
spawn 2 31 54
spawn 3 10 8
uscita A via_dei_consoli 3
uscita B via_xx_settembre 2
griglia
