# Area importata dal prototipo (tag prototipo-v0): SANT_ANDREA_GRID, MapId 9.
id sant_andrea
etichetta AREA_SANT_ANDREA
dimensioni 32 32
spawn 0 15 12
spawn 1 15 8
spawn 2 9 11
spawn 3 15 12
spawn 4 15 12
spawn 5 15 12
# F2, grafo reale: via XX Settembre (A) in alto, Sant'Agostino (B) a sinistra (sud), in fondo
# al vicolo di sinistra.
uscita A via_xx_settembre 1
uscita B sant_agostino 2
griglia
