# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id san_martino
etichetta AREA_SAN_MARTINO
dimensioni 64 64
# Dislivello: la salita va verso nord-est (in basso a destra); i gradoni corrono lungo il lato
# lungo dell'area, a valle c'e' l'ombra.
monte basso
riferimento 17 31
# Fattore ridotto: con 0,73 gli edifici e le distanze non entrano in 64x64 tile.
fattore 0.28
# porta_metauro: spostato di (-11, 0) tile perche' nei rettangoli del censimento si sovrapporrebbe
# a un altro edificio (o resterebbero meno di 2 tile per passare).
sposta porta_metauro -11 0
spawn 0 32 32
spawn 1 31 54
spawn 2 8 3
spawn 3 54 31
spawn 4 8 57
uscita A largo_bargello 1
uscita B piazza_quaranta_martiri 2
uscita E bottaccione 3
uscita G teatro_romano 4
griglia
