# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id duomo_ducale
etichetta AREA_DUOMO_DUCALE
dimensioni 64 64
riferimento 30 39
# Fattore ridotto: con 0,73 gli edifici e le distanze non entrano in 64x64 tile.
fattore 0.55
# duomo: spostato di (-15, 0) tile perche' nei rettangoli del censimento si sovrapporrebbe
# a un altro edificio (o resterebbero meno di 2 tile per passare).
sposta duomo -15 0
spawn 0 27 32
spawn 1 25 8
spawn 2 31 54
uscita A san_martino 1
uscita B monte_ingino 2
griglia
