# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id via_xx_settembre
etichetta AREA_VIA_XX_SETTEMBRE
dimensioni 32 64
# Dislivello: la salita va verso nord-est (in basso a destra); i gradoni corrono lungo il lato
# lungo dell'area, a valle c'e' l'ombra.
monte basso
riferimento 16 32
fattore 0.73
spawn 0 16 32
spawn 1 9 8
spawn 2 15 54
spawn 3 12 8
spawn 4 15 10
uscita A piazza_grande 1
uscita B sant_andrea 2
uscita E piazza_quaranta_martiri 3 vicino_a A 16
uscita G duomo_ducale 4 vicino_a A 20
griglia
