# Area importata dal prototipo (tag prototipo-v0): SANT_AGOSTINO_GRID, MapId 8.
id sant_agostino
etichetta AREA_SANT_AGOSTINO
dimensioni 32 64
spawn 0 28 16
spawn 1 28 20
spawn 2 28 47
spawn 3 28 16
spawn 4 28 16
spawn 5 28 16
# F2: lati dei varchi da mondo/varchi.json: via XX Settembre (A) e' a destra (nord). La strada
# non sale piu' fino al bordo alto: il varco si apre nel muro di destra.
uscita A via_xx_settembre 1
uscita B sant_andrea 2
griglia
