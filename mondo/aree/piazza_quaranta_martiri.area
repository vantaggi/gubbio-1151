# Area impaginata in proporzione (F2): vie larghe quanto misura OSM, piazze in scala, edifici a
# misura vera disegnati da tools/genera_mondo.py; fuori dalle vie e dalle piazze case e muro.
# Area oltre 64 tile: il fondale e' una big map (Butano), perche' la piazza e i suoi edifici a
# misura vera non entrano in 64.
id piazza_quaranta_martiri
etichetta AREA_QUARANTA_MARTIRI
dimensioni 128 128
# Dislivello: la salita va verso nord-est (in basso a destra); i gradoni corrono lungo il lato
# lungo dell'area, a valle c'e' l'ombra.
monte basso
riferimento 64 66
# Fattore ridotto: con 0,73 gli edifici e le distanze non entrano in 128 tile.
fattore 0.49
# Piazza 40 Martiri: 180 x 73 m, in scala.
piazza Piazza 40 Martiri
# Strade dei varchi: via Piccardi verso via dei Consoli 5 tile (7,0 m), via della Repubblica verso via XX Settembre 7 (10,3 m).
# loggia_tiratori: spostato di (0, 9) tile, fuori dalla piazza o da un altro edificio.
sposta loggia_tiratori 0 9
# san_francesco: spostato di (0, -43) tile, fuori dalla piazza o da un altro edificio.
sposta san_francesco 0 -43
# santa_maria_laici: spostato di (0, 37) tile, fuori dalla piazza o da un altro edificio.
sposta santa_maria_laici 0 37
spawn 0 64 66
spawn 1 118 42
spawn 2 118 85
spawn 3 41 118
spawn 4 83 119
spawn 5 52 8
uscita A san_martino 1
uscita B via_dei_consoli 2 largo 5
uscita E san_pietro 3
uscita G via_xx_settembre 4 largo 7
uscita H teatro_romano 5
griglia
