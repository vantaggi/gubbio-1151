# Area impaginata da mondo/monumenti.json (F2, scala 1 tile = 1,5 m). Gli edifici li disegna
# tools/genera_mondo.py; qui ci sono il fondo, i varchi, gli spawn e i decori.
id piazza_quaranta_martiri
etichetta AREA_QUARANTA_MARTIRI
dimensioni 64 64
riferimento 13 24
# Fattore ridotto: con 0,73 gli edifici e le distanze non entrano in 64x64 tile.
fattore 0.62
# santa_maria_laici: spostato di (-21, -4) tile perche' nei rettangoli del censimento si sovrapporrebbe
# a un altro edificio (o resterebbero meno di 2 tile per passare).
sposta santa_maria_laici -21 -4
spawn 0 32 30
spawn 1 54 20
spawn 2 54 41
spawn 3 14 54
spawn 4 7 54
uscita A san_martino 1
uscita B via_dei_consoli 2
uscita E san_pietro 3
uscita G via_xx_settembre 4
griglia
