# La gola del Bottaccione, seconda stanza (B-02): le chiazze di nebbia verde dei miasmi (g) sulla
# via; ci si cammina, ma si perdono HP lontano da Ubaldo.
id gola_miasmi
etichetta AREA_GOLA_MIASMI
dimensioni 64 32
# la gola sale verso nord, a destra sullo schermo
monte destra
riferimento 32 16
fattore 0.21
spawn 0 8 15
spawn 1 55 15
uscita A gola_striscia 0
uscita B gola_arco 1
griglia
